# Only use after reviewing and deploying the exact contract graph.
CLAUS_RPC_URL=
# Programmable Custom Launch API key; obtained through the controller account.
# Requires Ethereum custom-launch:create and custom-launch:read. Never a wallet key.
PROGRAMMABLE_API_KEY=
# Immutable purchase bot key: trusted to select NFT prices; not required for dry-run.
# Holds gas ETH only, but can direct acquisition spending through valid NFT orders.
CLAUS_KEEPER_PRIVATE_KEY=
# OpenSea API key is required for fetching live listing fulfillment data.
OPENSEA_API_KEY=
# Optional read-only mainnet-fork test RPC. It never sends a transaction to mainnet.
CLAUS_FORK_RPC=
